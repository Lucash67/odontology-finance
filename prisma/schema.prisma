generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  FINANCIAL
  RECEPTIONIST
}

enum TreatmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
}

enum Recurrence {
  NONE
  MONTHLY
  YEARLY
}

enum WhatsAppMessageStatus {
  QUEUED
  SIMULATED
  SENT
  DELIVERED
  FAILED
}

enum DueRule {
  FIXED_DAY
  INTERVAL_MONTHS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RECEPTIONIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receivablePayments ReceivablePayment[]
  expensePayments    ExpensePayment[]
  auditLogs          AuditLog[]
  whatsappMessages   WhatsAppMessage[]

  @@map("users")
}

model Setting {
  id                   String   @id @default(cuid())
  clinicName           String   @default("Consultório Odontológico")
  defaultDueDay        Int      @default(5)
  reminderDaysBefore   Int      @default(3)
  overdueChargeDays    Int      @default(3)
  whatsappEnabled      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("settings")
}

model Patient {
  id        String   @id @default(cuid())
  fullName  String
  document  String?
  phone     String?
  whatsapp  String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments         Treatment[]
  installments       ReceivableInstallment[]
  payments           ReceivablePayment[]
  whatsappMessages   WhatsAppMessage[]

  @@index([fullName])
  @@map("patients")
}

model Dentist {
  id        String   @id @default(cuid())
  fullName  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments Treatment[]

  @@index([fullName])
  @@map("dentists")
}

model Treatment {
  id               String          @id @default(cuid())
  patientId        String
  dentistId        String
  description      String
  contractedAmount Decimal         @db.Decimal(12, 2)
  status           TreatmentStatus @default(DRAFT)
  budgetDate       DateTime?
  notes            String?
  importSource     String?
  externalRef      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  patient      Patient                @relation(fields: [patientId], references: [id])
  dentist      Dentist                @relation(fields: [dentistId], references: [id])
  paymentPlan  PaymentPlan?
  installments ReceivableInstallment[]
  payments     ReceivablePayment[]

  @@index([patientId])
  @@index([dentistId])
  @@index([status])
  @@map("treatments")
}

model PaymentPlan {
  id                 String            @id @default(cuid())
  treatmentId        String            @unique
  downPaymentAmount  Decimal           @db.Decimal(12, 2) @default(0)
  installmentsCount  Int
  installmentAmount  Decimal           @db.Decimal(12, 2)
  firstDueDate       DateTime
  dueDay             Int
  dueRule            DueRule           @default(INTERVAL_MONTHS)
  intervalMonths     Int               @default(1)
  status             PaymentPlanStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  treatment    Treatment               @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  installments ReceivableInstallment[]

  @@map("payment_plans")
}

model ReceivableInstallment {
  id             String            @id @default(cuid())
  paymentPlanId  String
  treatmentId    String
  patientId      String
  sequenceNumber Int
  dueDate        DateTime
  amount         Decimal           @db.Decimal(12, 2)
  amountPaid     Decimal           @db.Decimal(12, 2) @default(0)
  status         InstallmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  paymentPlan PaymentPlan          @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  treatment   Treatment            @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  patient     Patient              @relation(fields: [patientId], references: [id])
  payments    ReceivablePayment[]
  whatsappMessages WhatsAppMessage[]

  @@unique([paymentPlanId, sequenceNumber])
  @@index([dueDate])
  @@index([status])
  @@index([patientId])
  @@map("receivable_installments")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivablePayments ReceivablePayment[]
  expensePayments    ExpensePayment[]

  @@map("payment_methods")
}

model ReceivablePayment {
  id              String    @id @default(cuid())
  installmentId   String
  treatmentId     String
  patientId       String
  paymentMethodId String
  amount          Decimal   @db.Decimal(12, 2)
  paidAt          DateTime
  notes           String?
  createdById     String?
  voidedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  installment   ReceivableInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  treatment     Treatment             @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  patient       Patient               @relation(fields: [patientId], references: [id])
  paymentMethod PaymentMethod         @relation(fields: [paymentMethodId], references: [id])
  createdBy     User?                 @relation(fields: [createdById], references: [id])

  @@index([paidAt])
  @@index([installmentId])
  @@map("receivable_payments")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("EXPENSE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("categories")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([name])
  @@map("suppliers")
}

model Expense {
  id          String        @id @default(cuid())
  supplierId  String?
  categoryId  String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @db.Decimal(12, 2) @default(0)
  dueDate     DateTime
  status      ExpenseStatus @default(PENDING)
  recurrence  Recurrence    @default(NONE)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  supplier Supplier?        @relation(fields: [supplierId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  payments ExpensePayment[]

  @@index([dueDate])
  @@index([status])
  @@map("expenses")
}

model ExpensePayment {
  id              String    @id @default(cuid())
  expenseId       String
  paymentMethodId String
  amount          Decimal   @db.Decimal(12, 2)
  paidAt          DateTime
  notes           String?
  createdById     String?
  voidedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  expense       Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id])

  @@index([paidAt])
  @@map("expense_payments")
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@map("whatsapp_templates")
}

model WhatsAppMessage {
  id             String                 @id @default(cuid())
  patientId      String?
  installmentId  String?
  templateId     String?
  toPhone        String
  body           String
  status         WhatsAppMessageStatus  @default(QUEUED)
  errorMessage   String?
  createdById    String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  patient     Patient?          @relation(fields: [patientId], references: [id])
  installment ReceivableInstallment? @relation(fields: [installmentId], references: [id])
  template    WhatsAppTemplate? @relation(fields: [templateId], references: [id])
  createdBy   User?             @relation(fields: [createdById], references: [id])

  @@index([status])
  @@map("whatsapp_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
